{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ripple.example.com/contracts/action-manifest.schema.json",
  "title": "ActionManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "case_version", "plan_id", "actions", "manifest_hash"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "case_id": { "type": "string", "minLength": 1 },
    "case_version": { "type": "integer", "minimum": 1 },
    "plan_id": { "type": "string", "minLength": 1 },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/artifactAction" },
          { "$ref": "#/$defs/calendarAction" },
          { "$ref": "#/$defs/mailAction" }
        ]
      }
    },
    "manifest_hash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "base": {
      "type": "object",
      "required": ["action_id", "idempotency_key", "required"],
      "properties": {
        "action_id": { "type": "string", "minLength": 1 },
        "idempotency_key": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" }
      }
    },
    "artifactAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "action_id", "idempotency_key", "required", "title", "sections"],
      "properties": {
        "type": { "const": "ARTIFACT_UPSERT" },
        "action_id": { "type": "string", "minLength": 1 },
        "idempotency_key": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "title": { "type": "string", "minLength": 1 },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "heading", "body_text"],
            "properties": {
              "key": { "type": "string", "minLength": 1 },
              "heading": { "type": "string", "minLength": 1 },
              "body_text": { "type": "string" }
            }
          }
        },
        "artifact_ref": { "type": "string" },
        "expected_version": { "type": "string" }
      }
    },
    "calendarAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "action_id", "idempotency_key", "required", "title", "start_at", "end_at", "timezone"],
      "properties": {
        "type": { "enum": ["CALENDAR_HOLD_UPSERT", "CALENDAR_LINK_BRIEF"] },
        "action_id": { "type": "string", "minLength": 1 },
        "idempotency_key": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "event_ref": { "type": "string" },
        "expected_version": { "type": "string" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "proposal_for": {
          "type": "object",
          "additionalProperties": false,
          "required": ["event_ref", "source_calendar", "original_title", "organizer_email"],
          "properties": {
            "event_ref": { "type": "string", "minLength": 1 },
            "source_calendar": { "enum": ["PRIMARY", "SELECTED"] },
            "original_title": { "type": "string", "minLength": 1 },
            "organizer_email": { "type": "string", "format": "email" }
          }
        },
        "reschedule_owned": {
          "type": "object",
          "additionalProperties": false,
          "required": ["event_ref", "source_calendar", "original_title", "expected_version"],
          "properties": {
            "event_ref": { "type": "string", "minLength": 1 },
            "source_calendar": { "enum": ["PRIMARY", "SELECTED"] },
            "original_title": { "type": "string", "minLength": 1 },
            "expected_version": { "type": "string", "minLength": 1 }
          }
        },
        "start_at": { "type": "string", "format": "date-time" },
        "end_at": { "type": "string", "format": "date-time" },
        "timezone": { "type": "string", "minLength": 1 }
      }
    },
    "mailAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "action_id", "idempotency_key", "required", "to", "cc", "bcc", "subject", "body_text"],
      "properties": {
        "type": { "const": "MAIL_SEND" },
        "action_id": { "type": "string", "minLength": 1 },
        "idempotency_key": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "thread_ref": { "type": "string" },
        "to": { "type": "array", "items": { "type": "string", "format": "email" }, "minItems": 1, "uniqueItems": true },
        "cc": { "type": "array", "items": { "type": "string", "format": "email" }, "uniqueItems": true },
        "bcc": { "type": "array", "items": { "type": "string", "format": "email" }, "uniqueItems": true },
        "subject": { "type": "string", "minLength": 1, "maxLength": 998 },
        "body_text": { "type": "string", "minLength": 1 }
      }
    }
  }
}
